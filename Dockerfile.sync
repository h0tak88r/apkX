# Dockerfile for GitLab Sync Daemon
# Lightweight background service that syncs files to GitLab

FROM golang:1.21-alpine AS builder

WORKDIR /build

# Install build dependencies
RUN apk add --no-cache git

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . ./

# Build sync daemon
RUN go build -o gitlab-sync-daemon cmd/gitlab-sync-daemon/main.go

# Final stage - minimal runtime
FROM alpine:latest

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/gitlab-sync-daemon /app/

# Run the sync daemon
CMD ["/app/gitlab-sync-daemon", "-dir", "/web-data"]

